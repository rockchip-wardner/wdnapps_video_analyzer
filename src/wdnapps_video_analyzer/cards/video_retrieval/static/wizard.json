{
  "enabled": true,
  "wizard_title": "监控反查快速配置",
  "swcap_to_model": {
    "swcap_vision_embedding": {
      "npu_index": 1,
      "model_id": "qwen3-vl-embedding-2b"
    }
  },
  "open_source_button": "vr-open",
  "canvas_id": "vr-canvas",
  "upload_endpoint": "/api/video-retrieval/upload",
  "start_buttons": [
    "vr-start"
  ],
  "steps": [
    {
      "id": "env",
      "title": "运行环境检查",
      "kind": "env_check"
    },
    {
      "id": "source",
      "title": "视频源",
      "kind": "form",
      "fields": [
        {
          "id": "vr-source",
          "ui_key": "source",
          "label": "视频源 URL / 路径",
          "placeholder": "例 /userdata/test/clips/sample.mp4"
        },
        {
          "id": "vr-loop",
          "ui_key": "loop",
          "label": "循环播放",
          "type": "checkbox",
          "default": true
        },
        {
          "id": "vr-judge-mode",
          "ui_key": "judgeMode",
          "label": "判帧算法（决定哪些秒送去切片）",
          "type": "select",
          "options": [
            {
              "value": "manual",
              "label": "手动间隔（按固定间隔取帧，不比对画面）"
            },
            {
              "value": "gscore",
              "label": "gscore 画面变化（推荐：静止画面不重复切片）",
              "selected": true
            }
          ]
        },
        {
          "id": "vr-judge-threshold",
          "ui_key": "judgeThreshold",
          "label": "变化阈值（越小越敏感）",
          "type": "number",
          "default": 10,
          "min": "0.1",
          "step": "0.1",
          "placeholder": "默认 10（刻度按算法不同，切换算法会换成该算法的默认值）"
        },
        {
          "id": "vr-judge-every-n",
          "ui_key": "judgeEveryN",
          "label": "帧间隔（有变化时的最长间隔）",
          "type": "number",
          "default": 10,
          "min": "1",
          "max": "3600",
          "step": "1",
          "placeholder": "默认 10（无变化时，最多会隔 10 秒再取一帧）"
        }
      ]
    },
    {
      "id": "search",
      "title": "检索问题",
      "kind": "form",
      "fields": [
        {
          "id": "vr-text",
          "ui_key": "searchText",
          "label": "例:视频里有没有车辆驶出停车场",
          "summary_label": "检索问题",
          "type": "textarea"
        },
        {
          "id": "vr-search-image",
          "ui_key": "searchImage",
          "label": "检索图片（可选，可与文字组合）",
          "type": "text",
          "browse": true,
          "upload": true,
          "image_preview": true,
          "thumbnail_endpoint": "/api/video-retrieval/image/thumb",
          "placeholder": "选择或上传一张图片；留空则只用文字检索"
        },
        {
          "id": "vr-check-image-quality",
          "ui_key": "checkImageQuality",
          "label": "图片质量检查（拒绝纯色 / 噪声图）",
          "type": "checkbox",
          "default": true
        }
      ]
    },
    {
      "id": "finish",
      "title": "完成配置",
      "kind": "finish"
    }
  ]
}
